#!/bin/sh
# git.next pre-push hook: block pushes whose changed files are governed by conflicting AI instructions.
#
# Install:  cp examples/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Needs `git-next` on PATH (npm link in the git-next checkout). Skip once with: git push --no-verify
#
# Optional: point GIT_NEXT_LAYERS at a stack.json to include org/contract/tool/personal layers,
# and set GIT_NEXT_STRICT_RESOURCES=1 to also block pushes that add Cloudflare bindings vs the remote branch.

command -v git-next >/dev/null 2>&1 || { echo "git-next not on PATH; skipping instruction checks" >&2; exit 0; }

layers=""
[ -n "$GIT_NEXT_LAYERS" ] && layers="--layers $GIT_NEXT_LAYERS"

zero=0000000000000000000000000000000000000000
status=0
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	# Check the rules that govern the files this push changes (all files for a new branch).
	paths=""
	[ "$remote_sha" != "$zero" ] && paths=$(git diff --name-only "$remote_sha" "$local_sha")
	# shellcheck disable=SC2086
	if ! git next rules --quiet $layers -- $paths; then
		echo "git-next: instruction conflicts govern files in this push. Run 'git next rules $layers -- <paths>' for details, or push with --no-verify." >&2
		status=1
	fi
	if [ "$GIT_NEXT_STRICT_RESOURCES" = "1" ] && [ "$remote_sha" != "$zero" ]; then
		if ! git next resources --base "$remote_sha" --ref "$local_sha" --strict --quiet; then
			echo "git-next: this push adds Cloudflare bindings (run 'git next resources --base $remote_sha --ref $local_sha --verbose')." >&2
			status=1
		fi
	fi
done
exit $status
