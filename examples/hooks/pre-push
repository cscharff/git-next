#!/bin/sh
# git.next pre-push hook (fail-closed): block pushes whose changed files are governed by conflicting AI
# instructions or violate the org catalog (unapproved model, unlisted resource, inline secret).
#
# Install:  cp examples/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#           (`git next new` installs it for you). Needs `git-next` on PATH (npm link in the git-next checkout).
#
# Fail-closed: if git-next is missing or cannot load the layers/catalog, the push is blocked.
# Escape hatch for errors only (never for conflicts): GIT_NEXT_ALLOW_ON_ERROR=1 git push
# Skip entirely, once:                                git push --no-verify
#
# Options: GIT_NEXT_LAYERS=<stack.json> adds org/contract/tool/personal layers (and their project's catalog.json);
#          GIT_NEXT_CATALOG=<catalog.json> enforces an org catalog on repos without one;
#          GIT_NEXT_STRICT_RESOURCES=1 also blocks pushes that add Cloudflare bindings vs the remote branch.

allow_on_error=""
[ "$GIT_NEXT_ALLOW_ON_ERROR" = "1" ] && allow_on_error="--allow-on-error"

if ! command -v git-next >/dev/null 2>&1; then
	if [ -n "$allow_on_error" ]; then
		echo "git-next: not on PATH; skipping checks because GIT_NEXT_ALLOW_ON_ERROR=1" >&2
		exit 0
	fi
	echo "git-next: not on PATH, so instruction and catalog checks cannot run. Blocking (fail-closed)." >&2
	echo "          Install it (npm link in the git-next checkout) or set GIT_NEXT_ALLOW_ON_ERROR=1." >&2
	exit 1
fi

set --
[ -n "$GIT_NEXT_LAYERS" ] && set -- "$@" --layers "$GIT_NEXT_LAYERS"
[ -n "$GIT_NEXT_CATALOG" ] && set -- "$@" --catalog "$GIT_NEXT_CATALOG"
[ -n "$allow_on_error" ] && set -- "$@" "$allow_on_error"

zero=0000000000000000000000000000000000000000
status=0
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	# Paths go through stdin, NUL-separated, so file names are never split or expanded by the shell.
	if [ "$remote_sha" = "$zero" ]; then
		git next rules --quiet "$@" </dev/null
	else
		git diff -z --name-only "$remote_sha" "$local_sha" | git next rules --quiet --paths-from-stdin "$@"
	fi
	code=$?
	if [ "$code" -eq 1 ]; then
		echo "git-next: instruction conflicts or catalog violations in this push (see above). Fix them, or push with --no-verify." >&2
		status=1
	elif [ "$code" -ne 0 ]; then
		echo "git-next: could not check this push (exit $code). Blocking (fail-closed); GIT_NEXT_ALLOW_ON_ERROR=1 to override." >&2
		status=1
	fi
	if [ "$GIT_NEXT_STRICT_RESOURCES" = "1" ] && [ "$remote_sha" != "$zero" ]; then
		if ! git next resources --base "$remote_sha" --ref "$local_sha" --strict --quiet; then
			echo "git-next: this push adds Cloudflare bindings (run 'git next resources --base $remote_sha --ref $local_sha --verbose')." >&2
			status=1
		fi
	fi
done
exit $status
