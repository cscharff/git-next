# Copy to .dev.vars (gitignored) for local dev. Never commit real values.
# Cloudflare account that owns the git-next AI Gateway.
CF_ACCOUNT_ID=
# API token with "AI Gateway: Read" on that account, for the cost provider's logs reads.
AIG_LOGS_TOKEN=
# Comma-separated Access identities allowed to override layer precedence (deployed only; localhost is admin in dev).
ADMIN_EMAILS=
# Access service token for local dev only: `npm run dev` passes these to cf dev, whose remote bindings reach the
# Access-protected workers.dev domain. `npm run deploy` leaves them out of the Worker's secrets.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
