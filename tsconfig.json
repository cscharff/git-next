{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": [
		"src",
		"cloudflare.config.ts",
		".cloudflare/types"
	],
	// The Node CLI is checked by tsconfig.cli.json.
	"exclude": ["src/cli"]
}
