{
	"version": "2026.10.5",
	"owner": "@acme/platform",
	"gateway": {
		"id": "git-next",
		"owner": "@acme/ai-platform",
		"how": "env.AI.run(model, input, { gateway: { id: \"git-next\", metadata: { developer, repo, fork, agent, task } } })",
		"rule": "org/AGENTS.md: call models only through the org AI Gateway"
	},
	"models": [
		{ "id": "anthropic/claude-fable-5.1", "jobs": ["planning"], "owner": "@acme/ai-platform", "rule": "approved for planning and orchestration only: never for code edits or app code" },
		{ "id": "anthropic/claude-opus-5.5", "class": "claude-opus-5.5", "jobs": ["planning", "review", "coding"], "owner": "@acme/ai-platform", "rule": "approved model providers; fallback planner" },
		{ "id": "anthropic/claude-sonnet-5.5", "jobs": ["coding", "review"], "owner": "@acme/ai-platform", "rule": "approved model providers" },
		{ "id": "anthropic/claude-sonnet-5", "class": "claude-sonnet-5", "jobs": ["coding", "review"], "owner": "@acme/ai-platform", "rule": "approved model providers" },
		{ "id": "anthropic/claude-haiku-4.5", "class": "claude-haiku-4.5", "jobs": ["chat", "classification"], "owner": "@acme/ai-platform", "rule": "approved model providers" },
		{ "id": "@cf/zai-org/glm-5.3-flash", "class": "glm-5.3-flash", "jobs": ["summaries", "extraction", "chores"], "owner": "@acme/ai-platform", "rule": "approved model providers", "keywords": ["summary", "summarize", "extract", "describe"] },
		{ "id": "@cf/moonshotai/kimi-k2.7-code", "jobs": ["coding", "review"], "owner": "@acme/ai-platform", "rule": "approved model providers" },
		{ "id": "@cf/google/embeddinggemma-300m", "jobs": ["embeddings"], "owner": "@acme/ai-platform", "rule": "approved model providers", "keywords": ["embedding", "search", "similar"] },
		{ "id": "bedrock/anthropic.claude-sonnet-5", "cloud": "aws", "class": "claude-sonnet-5", "jobs": ["coding", "review"], "owner": "@acme/ai-platform", "rule": "approved model providers (Bedrock, prod-aws)" },
		{ "id": "bedrock/anthropic.claude-haiku-4.5", "cloud": "aws", "class": "claude-haiku-4.5", "jobs": ["chat", "classification"], "owner": "@acme/ai-platform", "rule": "approved model providers (Bedrock, prod-aws)" },
		{ "id": "vertex/anthropic.claude-opus-5.5", "cloud": "gcp", "class": "claude-opus-5.5", "jobs": ["planning", "review", "coding"], "owner": "@acme/ai-platform", "rule": "approved model providers (Vertex AI, analytics-gcp)" },
		{ "id": "vllm/glm-5.3-flash", "cloud": "private", "class": "glm-5.3-flash", "jobs": ["summaries", "extraction", "chores"], "owner": "@acme/onprem", "rule": "on-prem inference (vLLM)" }
	],
	"bindings": [
		{
			"type": "r2_buckets",
			"class": "object-store",
			"owner": "@acme/storage",
			"naming": "acme-*",
			"rule": "only bind resources listed in the catalog",
			"keywords": ["upload", "uploads", "file", "files", "blob", "storage", "image"],
			"shared": [
				{ "name": "acme-shared-uploads", "binding": "UPLOADS", "owner": "@acme/storage", "how": "\"r2_buckets\": [{ \"binding\": \"UPLOADS\", \"bucket_name\": \"acme-shared-uploads\" }]  // keys: <repo>/<yyyy>/<mm>/<uuid>" }
			]
		},
		{ "type": "kv_namespaces", "class": "kv-cache", "owner": "@acme/platform", "naming": "acme-*", "keywords": ["cache", "session", "config"] },
		{ "type": "d1_databases", "class": "sql-db", "owner": "@acme/data", "naming": "acme-*", "keywords": ["database", "sql", "table", "metadata"] },
		{ "type": "durable_objects", "class": "compute", "owner": "@acme/platform", "keywords": ["state", "realtime", "websocket", "agent"] },
		{ "type": "queues", "class": "queue", "owner": "@acme/platform", "naming": "acme-*", "keywords": ["queue", "background", "async"] },
		{ "type": "workflows", "owner": "@acme/platform", "keywords": ["workflow", "steps", "retry"] },
		{ "type": "ai", "class": "ai", "owner": "@acme/ai-platform", "how": "\"ai\": { \"binding\": \"AI\" } and always pass gateway: { id: \"git-next\" }", "rule": "call models only through the org AI Gateway", "keywords": ["ai", "model", "llm", "summary"] },
		{ "type": "services", "owner": "@acme/platform" },
		{ "type": "artifacts", "owner": "@acme/platform" },
		{ "type": "worker_loaders", "owner": "@acme/security", "rule": "dynamic Workers only for sandboxed third-party code, with no outbound network unless reviewed", "keywords": ["sandbox", "plugin", "plugins", "isolate"] },
		{ "type": "images", "owner": "@acme/storage", "keywords": ["image", "images", "resize", "thumbnail"] },
		{ "type": "assets", "owner": "@acme/platform" },
		{ "type": "analytics_engine_datasets", "owner": "@acme/platform", "keywords": ["metrics", "analytics"] },
		{ "type": "s3", "cloud": "aws", "class": "object-store", "service": "S3", "owner": "@acme/storage", "naming": "acme-*" },
		{ "type": "rds", "cloud": "aws", "class": "sql-db", "service": "RDS Postgres", "owner": "@acme/data" },
		{ "type": "elasticache", "cloud": "aws", "class": "kv-cache", "service": "ElastiCache", "owner": "@acme/platform" },
		{ "type": "sqs", "cloud": "aws", "class": "queue", "service": "SQS", "owner": "@acme/platform" },
		{ "type": "ecs", "cloud": "aws", "class": "compute", "service": "ECS Fargate", "owner": "@acme/platform" },
		{ "type": "bedrock", "cloud": "aws", "class": "ai", "service": "Bedrock", "owner": "@acme/ai-platform" },
		{ "type": "secrets-manager", "cloud": "aws", "class": "secrets", "service": "Secrets Manager", "owner": "@acme/security" },
		{ "type": "gcs", "cloud": "gcp", "class": "object-store", "service": "GCS", "owner": "@acme/storage", "naming": "acme-*" },
		{ "type": "cloud-sql", "cloud": "gcp", "class": "sql-db", "service": "Cloud SQL", "owner": "@acme/data" },
		{ "type": "pubsub", "cloud": "gcp", "class": "queue", "service": "Pub/Sub", "owner": "@acme/platform" },
		{ "type": "cloud-run", "cloud": "gcp", "class": "compute", "service": "Cloud Run", "owner": "@acme/platform" },
		{ "type": "vertex-ai", "cloud": "gcp", "class": "ai", "service": "Vertex AI", "owner": "@acme/ai-platform" },
		{ "type": "minio", "cloud": "private", "class": "object-store", "service": "MinIO", "owner": "@acme/onprem" },
		{ "type": "ceph", "cloud": "private", "class": "object-store", "service": "Ceph", "owner": "@acme/onprem" },
		{ "type": "postgres", "cloud": "private", "class": "sql-db", "service": "Postgres", "owner": "@acme/onprem" },
		{ "type": "redis", "cloud": "private", "class": "kv-cache", "service": "Redis", "owner": "@acme/onprem" },
		{ "type": "kubernetes", "cloud": "private", "class": "compute", "service": "Kubernetes", "owner": "@acme/onprem" },
		{ "type": "vllm", "cloud": "private", "class": "ai", "service": "vLLM", "owner": "@acme/onprem" },
		{ "type": "vault", "cloud": "private", "class": "secrets", "service": "Vault", "owner": "@acme/security" }
	],
	"tools": {
		"mcpServers": [{ "name": "cloudflare-docs", "url": "https://docs.mcp.cloudflare.com/mcp", "owner": "@acme/devex" }],
		"skills": [{ "name": "security-scan", "owner": "@acme/security" }]
	},
	"checks": [
		{ "name": "instruction stack and catalog", "command": "git next rules", "rule": "pre-push hook (fail-closed)" },
		{ "name": "tests", "command": "pnpm test" },
		{ "name": "security scan", "command": "security-scan", "rule": "tool/AGENTS.md" }
	]
}
