{
	// Generated by `git next new` from org-baseline. Secrets go in `wrangler secret put NAME` (or .dev.vars locally), never here.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "{{name}}",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Workers AI only through the org gateway: pass { gateway: { id: "git-next" } } on every env.AI.run call.
	"ai": { "binding": "AI" }
	// Add only resources from .gitnext/catalog.json. Forks must not bind production resources.
}
